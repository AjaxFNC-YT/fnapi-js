{
  "name": "fnapi-js",
  "version": "2.0.6-beta.0",
  "description": "Zero-dependency TypeScript wrapper for the public Fortnite APIs with a full Epic Games account-service, realtime (XMPP/EOS), party, MCP and item-shop/gifting layer",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs.md",
    "config.example.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "cli": "tsx tools/cli.ts",
    "generate:mcp": "tsx tools/generate-mcp-operations.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "fortnite",
    "fortnite-api",
    "api",
    "wrapper",
    "typescript",
    "cosmetics",
    "item-shop",
    "lobbybot",
    "fortnite-bot",
    "epic-games"
  ],
  "author": "AjaxFNC-YT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjaxFNC-YT/fnapi-js.git"
  },
  "bugs": {
    "url": "https://github.com/AjaxFNC-YT/fnapi-js/issues"
  },
  "homepage": "https://github.com/AjaxFNC-YT/fnapi-js#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.0.5",
    "tsup": "^8.3.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
